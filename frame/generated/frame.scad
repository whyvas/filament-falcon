module ff_ram(a, b, d_body, d_rod, body_len, col = "#9aa0a6") {
  v = b - a; L = norm(v);
  color(col) hull() { translate(a) sphere(d = d_body); translate(a + v * min(body_len, L - 20) / L) sphere(d = d_body); }
  color("#d0d0d0") hull() { translate(a + v * min(body_len, L - 20) / L) sphere(d = d_rod); translate(b) sphere(d = d_rod); }
}
