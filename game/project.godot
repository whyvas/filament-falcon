; Engine configuration file.
; The Filament Falcon - home spaceship cockpit simulator.

config_version=5

[application]

config/name="The Filament Falcon"
config/description="Three-seat home spaceship cockpit simulator (two forward windows, kids' touch console, Commander screen, 3-headset intercom)."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="filament-falcon"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
InputHub="*res://scripts/autoload/input_hub.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Voice="*res://scripts/autoload/voice.gd"
LedLink="*res://scripts/autoload/led_link.gd"
Ics="*res://scripts/autoload/ics_link.gd"
Game="*res://scripts/autoload/game.gd"
Eva="*res://scripts/autoload/eva_link.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/screen_space_aa=1

[xr]

openxr/enabled=false
openxr/startup_alert=false
openxr/reference_space=2
openxr/default_action_map="res://openxr_action_map.tres"
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=false
shaders/enabled=true
