{
  "_comment": "GENERATED by firmware/tools/gen_input_map.py from firmware/include/config_*.h. Edit the headers, not this file.",
  "conventions": {
    "device": "match the joystick when its joy name CONTAINS the device key (e.g. 'Falcon Pilot'), or by usb_vid/usb_pid (Godot: Input.get_joy_info(id) vendor_id/product_id). Linux prefixes the manufacturer, so the evdev/SDL name is 'Filament Falcon Falcon Pilot'; Windows shows 'Falcon Pilot'. Do not use exact string equality.",
    "button": "0-based HID button index (Godot JoyButton / SDL button index). Godot raw index for unknown devices equals this number.",
    "axis": "0-based axis index in HID report order: 0=X 1=Y 2=Z 3=Rx 4=Ry 5=Rz 6=Slider 7=Dial. Values -1..1 (HID -32767..32767). Linux evdev: ABS_X..ABS_RZ, ABS_THROTTLE, ABS_RUDDER.",
    "bipolar": "spring-centred stick axis, 0 at rest, deadzone already applied in firmware",
    "unipolar": "lever/pot without centre: -1 = minimum (throttle idle / lights dim), +1 = maximum",
    "invert": "game-side flip; set true if a direction feels backwards (or flip in the config header)",
    "kind": "momentary = held while pressed; toggle = held while switch is ON (read the level, not edges); rotary = exactly one of the group is held; pulse = ~35 ms press per encoder click"
  },
